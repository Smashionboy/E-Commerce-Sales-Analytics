POSTGRES_DB=olist
POSTGRES_USER=olist
# Keep single quotes: Docker Compose preserves literal $, # and spaces.
POSTGRES_PASSWORD='replace_with_your_local_password'
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
# Optional DATABASE_URL overrides the values above. Encode special characters in URLs.
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/olist
